# JWT secret for signing tokens.
# Generate with: openssl rand -hex 32
# Never commit the real .env file — only this template.
JWT_SECRET=replace-me-with-openssl-rand-hex-32
# Только схема, хост и порт: без слэша на конце, без пути вроде /login.
# Порт 80 не указывается — браузер присылает Origin без него.
# Несколько адресов — через запятую.
# Прод за nginx на 80 порту: http://161.104.105.206
# Локальная разработка фронта:  http://localhost:3000
FRONTEND_ORIGIN=http://161.104.105.206,http://localhost:3000
# Postgres. Пароль только из [a-z0-9], он подставляется в URL.
# Сгенерировать: openssl rand -hex 16
POSTGRES_USER=bnn
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=bnn

# Для запуска бэкенда без докера (go run)
DATABASE_URL=postgres://bnn:replace-me@localhost:5432/bnn?sslmode=disable

# S3 (Silo). Пароль минимум 8 символов.
MINIO_ROOT_USER=bnn
MINIO_ROOT_PASSWORD=replace-me

# Для запуска бэкенда без докера (go run)
S3_ENDPOINT=localhost:9002
S3_ACCESS_KEY=bnn
S3_SECRET_KEY=replace-me
S3_ATTACHMENTS_BUCKET=attachments
S3_AVATARS_BUCKET=avatars